# --- AI model: choose ONE option -----------------------------------------
# Which provider to use: "openai" or "anthropic". If unset, OpenAI is used whenever
# AZURE_OPENAI_ENDPOINT or OPENAI_API_KEY is set, otherwise Claude.
NDA_PROVIDER=openai

# Option A - OpenAI GPT-5.2 in Microsoft Foundry / Azure OpenAI (billed through Azure)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# Leave the key unset to sign in with Microsoft Entra ID instead
# (managed identity in Azure, or `az login` on your computer).
# AZURE_OPENAI_API_KEY=<azure openai key>

# Option B - OpenAI directly
# OPENAI_API_KEY=sk-...

# Option C - Claude in Microsoft Foundry, or Option D - Claude API (set NDA_PROVIDER=anthropic)
# ANTHROPIC_FOUNDRY_RESOURCE=<foundry resource name>
# ANTHROPIC_FOUNDRY_API_KEY=<foundry key>      # or leave unset for Entra ID
# ANTHROPIC_API_KEY=sk-ant-...

# Model: on Azure this is your DEPLOYMENT name. Defaults: gpt-5.2 (OpenAI), claude-opus-5-5 (Claude).
NDA_MODEL=gpt-5.2
# Reasoning effort: low | medium | high | xhigh
NDA_EFFORT=high

# --- Review output --------------------------------------------------------
# Name shown on tracked changes and comments in Word
REDLINE_AUTHOR=Unifi Legal
REDLINE_INITIALS=UL
# Add margin comments citing the playbook rule behind each change (true/false).
# Turn off if you send the redline straight to the counterparty.
ADD_COMMENTS=true
# Defaults to playbooks/Unifi - MA NDA Playbook.docx (.docx, .md or .txt all work)
# PLAYBOOK_PATH=playbooks/Unifi - MA NDA Playbook.docx
MAX_UPLOAD_MB=15

# --- Azure Bot / Teams (from the Entra app registration used by your Azure Bot) ---
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<app (client) id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<client secret>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<directory (tenant) id>

PORT=3978
